

model Contract {
  id String @id @default(uuid())

  clientId                  String
  professionalId            String
  eventId                   String
  eventServiceRequirementId String
  professionalServiceId     String
  proposalId                String @unique

  agreedAmount Decimal @db.Decimal(12, 2)
  currency     String  @default("BDT") @db.VarChar(10)

  serviceStartAt DateTime
  serviceEndAt   DateTime

  status ContractStatus @default(PENDING)

  terms String? @db.Text

  confirmedAt        DateTime?
  startedAt          DateTime?
  completedAt        DateTime?
  cancelledAt        DateTime?
  cancellationReason String? @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  client                  Client                  @relation(fields: [clientId], references: [id], onDelete: Restrict)
  professional            Professional            @relation(fields: [professionalId], references: [id], onDelete: Restrict)
  event                   Event                   @relation(fields: [eventId], references: [id], onDelete: Restrict)
  eventServiceRequirement EventServiceRequirement @relation(fields: [eventServiceRequirementId], references: [id], onDelete: Restrict)
  professionalService     ProfessionalService     @relation(fields: [professionalServiceId], references: [id], onDelete: Restrict)
  proposal                Proposal                @relation(fields: [proposalId], references: [id], onDelete: Restrict)

  payments     Payment[]
  reviews      Review[]
  disputes     Dispute[]
  deliverables Deliverable?

  @@index([clientId])
  @@index([professionalId])
  @@index([eventId])
  @@index([eventServiceRequirementId])
  @@index([status])
  @@index([serviceStartAt, serviceEndAt])


}

  
