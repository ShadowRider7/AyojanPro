model Payment {
  id         String @id @default(uuid())
  contractId String
  clientId String

  stage  PaymentStage
  status PaymentStatus @default(PENDING)
  method PaymentMethod @default(BKASH)

  amount   Decimal @db.Decimal(12, 2)
  currency String  @default("BDT") @db.VarChar(10)

  bkashPaymentId        String? @unique @db.VarChar(255)
  bkashTransactionId    String? @unique @db.VarChar(255)
  payerReference        String? @db.VarChar(255)
  merchantInvoiceNumber String? @unique @db.VarChar(255)

  transactionTime DateTime?
  paidAt          DateTime?

  failureReason String? @db.Text
  metadata      Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  contract Contract @relation(fields: [contractId], references: [id], onDelete: Restrict)
  client Client @relation(fields: [clientId],references: [id])

  @@unique([contractId, stage])
  @@index([status])
  @@index([bkashPaymentId])
  @@index([bkashTransactionId])
}
