model AuditLog {
  id           String      @id @default(uuid())

  actorId      String                          
  action       AuditAction
  entityType   String      @db.VarChar(100)     
  entityId     String                          

  previousData Json?                            
  newData      Json?                           
  metadata     Json?                            

  actor        User        @relation("AuditActor", fields: [actorId], references: [id])

  createdAt    DateTime    @default(now())

  @@index([actorId])
  @@index([action])
  @@index([entityType, entityId])
  @@index([createdAt])
  @@map("audit_logs")
}