

model Dispute {
  id         String @id @default(uuid())
  contractId String
  raisedById String

  raisedByRole DisputeRaisedBy

  reason      String @db.VarChar(255)
  description String @db.Text

  status DisputeStatus @default(OPEN)

  resolution   String?   @db.Text
  resolvedById String?
  resolvedAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  contract   Contract @relation(fields: [contractId], references: [id], onDelete: Cascade)
  raisedBy   User     @relation("DisputeRaisedBy", fields: [raisedById], references: [id], onDelete: Restrict)
  resolvedBy User?    @relation("DisputeResolvedBy", fields: [resolvedById], references: [id], onDelete: SetNull)

  evidences DisputeEvidence[]

  @@index([contractId])
  @@index([raisedById])
  @@index([status])
}
