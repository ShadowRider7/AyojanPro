model Project {
  id       String @id @default(uuid())
  clientId String

  title       String   @db.VarChar(255)
  description String
  budget      Decimal  @db.Decimal(12, 2)
  deadline    DateTime
  location    String?
  category    String?  @db.VarChar(100)

  // Required services stored as plain strings (no join table needed;
  // matched against CreatorService.name in search queries)
  requiredServices String[]

  status ProjectStatus @default(DRAFT)

  isDeleted Boolean   @default(false)
  deletedAt DateTime?

  client Client @relation(fields: [clientId], references: [id])

  skills    ProjectSkill[]
  proposals Proposal[]
  contract  Contract?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([clientId])
  @@index([status])
  @@index([category])
  @@index([budget])
  @@index([deadline])
  @@index([location])
  @@index([isDeleted])
  @@map("projects")
}
