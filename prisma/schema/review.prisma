model Review {
  id             String   @id @default(uuid())
  contractId     String
  clientId       String
  professionalId String
  reviewByClient Boolean  // true = Client reviewed Professional | false = Professional reviewed Client
  rating         Int
  comment        String?  @db.Text
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  // Relations
  contract     Contract     @relation(fields: [contractId], references: [id], onDelete: Cascade)
  client       Client       @relation(fields: [clientId], references: [id], onDelete: Restrict)
  professional Professional @relation(fields: [professionalId], references: [id], onDelete: Restrict)

  // Enforces that each party can only review the other once per contract
  @@unique([contractId, clientId, professionalId, reviewByClient])
  @@index([clientId])
  @@index([professionalId])
  @@index([rating])
}

