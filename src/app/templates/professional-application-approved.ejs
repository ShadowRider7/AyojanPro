<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Application Approved</title>
    <style>
      /* Reset & Base Styles */
      * {
        box-sizing: border-box;
      }
      body {
        margin: 0;
        padding: 0;
        width: 100% !important;
        -webkit-text-size-adjust: 100%;
        -ms-text-size-adjust: 100%;
        background-color: #f7f7f7;
        font-family: Arial, Helvetica, sans-serif;
        color: #333333;
      }
      img {
        line-height: 100%;
        outline: none;
        text-decoration: none;
        -ms-interpolation-mode: bicubic;
        border: 0;
      }
      table {
        border-collapse: collapse !important;
        mso-table-lspace: 0pt;
        mso-table-rspace: 0pt;
      }
      td {
        font-family: Arial, Helvetica, sans-serif;
      }
      /* Utility Styles */
      .wrapper {
        width: 100%;
        table-layout: fixed;
        background-color: #f7f7f7;
        padding: 40px 0;
      }
      .container {
        width: 100%;
        max-width: 500px;
        margin: 0 auto;
        background-color: #ffffff;
        border-radius: 8px;
        border: 1px solid #e0e0e0;
        box-shadow: 0 2px 8px rgba(0, 0, 0, 0.04);
      }
      /* Content Styles */
      .content-padding {
        padding: 40px 30px;
      }
      h2 {
        margin: 0 0 20px 0;
        font-size: 24px;
        line-height: 30px;
        color: #111111;
        font-weight: bold;
      }
      p {
        margin: 0 0 16px 0;
        font-size: 15px;
        line-height: 24px;
        color: #444444;
      }
      p:last-of-type {
        margin-bottom: 30px;
      }
      .password-box {
        width: 100%;
        margin-bottom: 24px;
        background-color: #f0fdf4;
        border-left: 4px solid #16a34a;
      }
      .password-text {
        padding: 14px 16px;
        font-size: 14px;
        line-height: 22px;
        color: #166534;
      }
      .password-label {
        display: block;
        margin-bottom: 6px;
        font-weight: bold;
      }
      .password-value {
        font-family: 'Courier New', Courier, monospace;
        font-size: 18px;
        font-weight: bold;
        letter-spacing: 1px;
        color: #111111;
        background-color: #ffffff;
        padding: 8px 12px;
        border-radius: 4px;
        border: 1px solid #d1fae5;
        display: inline-block;
      }
      .btn-wrapper {
        margin-bottom: 10px;
      }
      .button {
        background-color: #0076ff;
        color: #ffffff !important;
        font-size: 16px;
        font-weight: bold;
        text-decoration: none;
        padding: 14px 28px;
        border-radius: 6px;
        display: inline-block;
        mso-padding-alt: 0;
        text-underline-color: #0076ff;
      }
      .footer {
        padding-top: 24px;
        border-top: 1px solid #eeeeee;
        font-size: 12px;
        line-height: 18px;
        color: #888888;
      }
    </style>
  </head>
  <body>
    <center class="wrapper">
      <!--[if mso]>
      <table align="center" border="0" cellpadding="0" cellspacing="0" width="500" style="width:500px; background-color:#ffffff;">
      <tr>
      <td>
      <![endif]-->
      <table class="container" cellpadding="0" cellspacing="0" width="100%" role="presentation">
        <tr>
          <td class="content-padding">
            <h2>Congratulations, <%= name %>!</h2>
            <p>Your application to join AyojanPro System as a professional has been reviewed and approved.</p>
            <p>You can now log in and start managing your profiles and services.</p>

            <% if (password) { %>
              <table class="password-box" cellpadding="0" cellspacing="0" role="presentation">
                <tr>
                  <td class="password-text">
                    <span class="password-label">Your Login Password:</span>
                    <span class="password-value"><%= password %></span>
                  </td>
                </tr>
              </table>
              <p style="font-size: 13px; color: #666666;">Please change your password after logging in for security purposes.</p>
            <% } %>
            
            <!-- Added a primary call-to-action button common for transactional approvals -->
            <table class="btn-wrapper" cellpadding="0" cellspacing="0" role="presentation">
              <tr>
                <td align="center" bgcolor="#0076ff" style="border-radius: 6px;">
                  <!--[if mso]>
                    <i style="letter-spacing: 25px; mso-font-width: -100%; mso-text-raise: 30pt;">&nbsp;</i>
                  <![endif]-->
                  <a href="https://example.com" class="button" target="_blank" style="color: #ffffff;">Log In to Dashboard</a>
                  <!--[if mso]>
                    <i style="letter-spacing: 25px; mso-font-width: -100%;">&nbsp;</i>
                  <![endif]-->
                </td>
              </tr>
            </table>
          </td>
        </tr>
        <tr>
          <td class="content-padding footer" align="left">
            &copy; AyojanPro System. All rights reserved.
          </td>
        </tr>
      </table>
      <!--[if mso]>
      </td>
      </tr>
      </table>
      <![endif]-->
    </center>
  </body>
</html>
